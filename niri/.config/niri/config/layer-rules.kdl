/*
[[ LAYER RULES ]]
*/
// Launcher transparency + blur
layer-rule {
    match namespace="^launcher$"
    match namespace="^vicinae$"
    opacity 0.7
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
  match namespace="dms:plugins:wallpaperCarousel*"
    opacity 0.99
    background-effect {
        blur true
        xray true
    }
}
// Shadows for gtk-layer-shell widgets (eww etc.)
layer-rule {
    match namespace="gtk-layer-shell"
    match at-startup=true
    shadow {
        on
        softness 10
        spread 1
        offset x=0 y=1
        draw-behind-window true
        color "#00000030"
    }
}

// Noctalia shell backdrops
layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
