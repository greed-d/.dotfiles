██╗    ██╗██╗███╗   ██╗██████╗  ██████╗ ██╗    ██╗    ██████╗ ██╗   ██╗██╗     ███████╗███████╗
██║    ██║██║████╗  ██║██╔══██╗██╔═══██╗██║    ██║    ██╔══██╗██║   ██║██║     ██╔════╝██╔════╝
██║ █╗ ██║██║██╔██╗ ██║██║  ██║██║   ██║██║ █╗ ██║    ██████╔╝██║   ██║██║     █████╗  ███████╗
██║███╗██║██║██║╚██╗██║██║  ██║██║   ██║██║███╗██║    ██╔══██╗██║   ██║██║     ██╔══╝  ╚════██║
╚███╔███╔╝██║██║ ╚████║██████╔╝╚██████╔╝╚███╔███╔╝    ██║  ██║╚██████╔╝███████╗███████╗███████║
 ╚══╝╚══╝ ╚═╝╚═╝  ╚═══╝╚═════╝  ╚═════╝  ╚══╝╚══╝     ╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚══════╝╚══════╝
*/
/*
[[ GLOBAL ]]
*/
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

/*
[[ FLOATING WINDOWS ]]
*/
window-rule {
    match title="^(file_progress)$"
    match title="^(confirm)$"
    match title="^(dialog)$"
    match title="^(download)$"
    match title="^(notification )$"
    match title="^(error)$"
    match title="^(splash)$"
    match title="^(nwg-look)$"
    match title="^(confirmreset)$"
    match title="^(Delete profile)$"
    match title="^File Operation Progress$"
    match title="^Confirm to replace files$"
    match title="^KDE Connect URL handler$"
    match title="^(Open File)(.*)$"
    match title="^(Select a File)(.*)$"
    match title="^(Choose wallpaper)(.*)$"
    match title="^(Open Folder)(.*)$"
    match title="^(Save As)(.*)$"
    match title="^(Library)(.*)$"
    match title="^(File Upload)(.*)$"
    match title="^(hyprland-share-picker)$"
    match title="^(.*)-Google$"
    match title="^(.*)System Update$"
    match title="(.*) - Google (.*) - (.*)"
    match app-id="^xdm-app$"
    match app-id="^org.qbittorrent.qBittorrent$"
    match app-id="^org.pulseaudio.pavucontrol$"
    match app-id="^net.davidotek.pupgui2$"
    match app-id="^com.github.th_ch.youtube_music$"
    open-floating true
}
window-rule {
    match app-id="zen$" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="Motrix"
    match app-id="motrix-next" title="Motrix Next"
    match app-id="com-abdownloadmanager-desktop-AppKt"
    match app-id="com-abdownloadmanager-desktop-AppKt" title="Settings"
    open-floating true
 // default-floating-position x=180 y=45
    // max-width 1515
    // max-height 955
 // min-width 700
}
window-rule {
    match app-id="com.github.th_ch.youtube_music"
    default-floating-position x=95 y=30
}
// Needed for steam, read wiki for more
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    match app-id="com.viber.Viber" title="ViberPC"
    default-floating-position x=10 y=10 relative-to="bottom-right"
}
// Floating Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia.Settings"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

/*
[[ WORKAROUNDS ]]
*/
// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id="^org\\.wezfurlong\\.wezterm$"
    default-column-width {

    }
}

/*
[[ DEFAULT STATES ]]
*/
window-rule {
    match app-id="org.telegram.desktop$"
    match app-id="zen$"
    match app-id="vesktop$"
    match app-id="thunar$"
    match app-id="dolphin$"
    match app-id="obsidian$"
    match app-id="com.github.th_ch.youtube_music"
    match app-id="Postman"
    match app-id="Spotify"
    match app-id="Element"
    match app-id="steam"
    match app-id="vivaldi-stable"
    match app-id="Emacs"
    match app-id="helium"
    match app-id="md.Obsidian"
    match app-id="neovide"
    open-maximized true
}
window-rule {
    match app-id="mpv$"
    open-fullscreen true
}

/*
[[ TRANSPARENCY & BLUR ]]
*/
window-rule {
    draw-border-with-background false
    match app-id="kitty$"
    match app-id="com.mitchellh.ghostty$"
    match app-id="footclient"
    match app-id="neovide"
    background-effect {
        blur true
    }
    opacity 0.9
}
window-rule {
    match app-id="com.github.th_ch.youtube_music$"
    match app-id="Spotify"
    match app-id="spotify"
    background-effect {
        blur true
    }
    opacity 0.9
}
window-rule {
    match app-id="^vesktop$"
    background-effect {
        blur true
    }
    opacity 0.9
}
window-rule {
    match app-id="^org.telegram.desktop$"
    background-effect {
        blur true
    }
    opacity 0.9
}

/*
[[ WORKSPACE ASSIGNMENTS ]]
*/
window-rule {
    match app-id="zen$"
    match app-id="helium$"
    open-on-workspace "🌍 WWW"
}
window-rule {
    match app-id="Postman$"
    open-on-workspace "🖳TERM"
}
window-rule {
    match app-id="^org.kde.dolphin$"
    open-on-workspace "📂 FILE"
}
window-rule {
    match app-id="^obsidian$"
    match app-id="^md.obsidian.Obsidian$"
    match app-id="sioyek"
    match app-id="md.Obsidian"
    open-on-workspace "📓 NOTE"
}
window-rule {
    match app-id="com.github.th_ch.youtube_music$"
    match app-id="Spotify"
    match app-id="spotify"
    open-on-workspace "🎵 SONG"
}
window-rule {
    match app-id="^vesktop$"
    open-on-workspace "💬 CHAT"
}
window-rule {
    match app-id="^org.telegram.desktop$"
    open-on-workspace "0"
}
