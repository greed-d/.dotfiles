workspace "🌍 WWW" {
    open-on-output "HDMI-A-1"
}
workspace "⚙️ DEV" {
    open-on-output "DP-2"
}
workspace "🗒️ JOT"
workspace "4"
workspace "5"
workspace "📂 FILE" {
    open-on-output "HDMI-A-1"
}
workspace "📓 NOTE"
workspace "🎵 SONG" {
    open-on-output "DP-2"
}
workspace "💬 CHAT" {
    open-on-output "HDMI-A-1"
}
workspace "0"
/*
[[ Layer Rule ]]
*/
// Set the overview wallpaper on the backdrop.
/*
██╗    ██╗██╗███╗   ██╗██████╗  ██████╗ ██╗    ██╗    ██████╗ ██╗   ██╗██╗     ███████╗███████╗
██║    ██║██║████╗  ██║██╔══██╗██╔═══██╗██║    ██║    ██╔══██╗██║   ██║██║     ██╔════╝██╔════╝
██║ █╗ ██║██║██╔██╗ ██║██║  ██║██║   ██║██║ █╗ ██║    ██████╔╝██║   ██║██║     █████╗  ███████╗
██║███╗██║██║██║╚██╗██║██║  ██║██║   ██║██║███╗██║    ██╔══██╗██║   ██║██║     ██╔══╝  ╚════██║
╚███╔███╔╝██║██║ ╚████║██████╔╝╚██████╔╝╚███╔███╔╝    ██║  ██║╚██████╔╝███████╗███████╗███████║
╚══╝╚══╝ ╚═╝╚═╝  ╚═══╝╚═════╝  ╚═════╝  ╚══╝╚══╝     ╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚══════╝╚══════╝
*/
window-rule {
    match title="^(file_progress)$"
    match title="^(confirm)$"
    match title="^(dialog)$"
    match title="^(download)$"
    match title="^(notification )$"
    match title="^(error)$"
    match title="^(splash)$"
    match title="^(nwg-look)$"
    match title="^(confirmreset)$"
    match title="^(Delete profile)$"
    match title="^File Operation Progress$"
    match title="^Confirm to replace files$"
    match title="^KDE Connect URL handler$"
    match title="^(Open File)(.*)$"
    match title="^(Select a File)(.*)$"
    match title="^(Choose wallpaper)(.*)$"
    match title="^(Open Folder)(.*)$"
    match title="^(Save As)(.*)$"
    match title="^(Library)(.*)$"
    match title="^(File Upload)(.*)$"
    match title="^(hyprland-share-picker)$"
    match title="^(.*)-Google$"
    match title="^(.*)System Update$"
    match title="(.*) - Google (.*) - (.*)"
    match app-id="^xdm-app$"
    match app-id="^org.qbittorrent.qBittorrent$"
    match app-id="^org.pulseaudio.pavucontrol$"
    match app-id="^net.davidotek.pupgui2$"
    match app-id="^com.github.th_ch.youtube_music$"
    open-floating true
}
window-rule {
    match app-id="zen$" title="^Picture-in-Picture$"
    match app-id="zen-twilight$" title="^Picture-in-Picture$"
    match title="^Picture in picture$"
    default-window-height {
        fixed 500
    }
    open-floating true
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id="^org\\.wezfurlong\\.wezterm$"
    default-column-width {

    }
}
window-rule {
    match app-id="com.github.th_ch.youtube_music"
    default-floating-position x=95 y=30
}
// Needed for steam, read wiki for more
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    match app-id="com.viber.Viber" title="ViberPC"
    match app-id="viber" title="ViberPC"
    default-floating-position x=10 y=10 relative-to="top-right"
    open-focused false
}
window-rule {
    match app-id="org.telegram.desktop$"
    match app-id="zen$"
    match app-id="zen-twilight$"
    match app-id="vesktop$"
    match app-id="thunar$"
    match app-id="dolphin$"
    match app-id="obsidian$"
    match app-id="com.github.th_ch.youtube_music"
    match app-id="Postman"
    match app-id="Spotify"
    match app-id="Element"
    match app-id="steam"
    match app-id="vivaldi-stable"
    match app-id="Emacs"
    match app-id="helium"
    match app-id="neovide"
    open-maximized true
}
window-rule {
    match app-id="mpv$"
    open-fullscreen true
}
window-rule {
    geometry-corner-radius 7
    clip-to-geometry true
}
debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}
/*
[[ App Rules ]]
*/
window-rule {
    draw-border-with-background false
    match app-id="kitty$"
    match app-id="com.mitchellh.ghostty$"
    match app-id="^foot*"
    match app-id="neovide"
    background-effect {
        blur true
    }
    opacity 0.93
}
window-rule {
    match app-id="zen$"
    match app-id="zen-twilight$"
    open-on-workspace "🌍 WWW"
}
window-rule {
    match app-id="Postman$"
    open-on-workspace "🖳TERM"
    background-effect {
        blur true
    }
    opacity 0.93
}
window-rule {
    match app-id="^org.kde.dolphin$"
    open-on-workspace "📂 FILE"
}
window-rule {
    match app-id="^obsidian$"
    open-on-workspace "📓 NOTE"
}
window-rule {
    match app-id="com.github.th_ch.youtube_music$"
    match app-id="[Ss]potify"
    open-on-workspace "🎵 SONG"
    background-effect {
        blur true
    }
    opacity 0.89
}
window-rule {
    match app-id="sioyek"
    open-on-workspace "📓 NOTE"
    background-effect {
        blur true
    }
    opacity 0.93
}
window-rule {
    match app-id="^vesktop$"
    match app-id="^com.viber.Viber$"
    open-on-workspace "💬 CHAT"
    background-effect {
        blur true
    }
    opacity 0.91
}
window-rule {
    match app-id="^org.telegram.desktop$"
    open-on-workspace "0"
}

